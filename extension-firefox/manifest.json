{
  "manifest_version": 3,
  "name": "BladeMail Download Manager Connector",
  "version": "1.3.0",
  "description": "Sends browser downloads and on-page videos to BladeMail Download Manager for faster, resumable downloads.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BladeMail Download Manager"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "downloads",
    "cookies",
    "storage",
    "webRequest",
    "contextMenus",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "blademail-connector@blademail.app",
      "strict_min_version": "121.0"
    }
  }
}
